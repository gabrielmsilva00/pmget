# Section: Argument Parsing

parse_args() {
    local mode=""
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --wsl) ;; # Already dispatched on Windows; harmless inside WSL/Linux.
            --refresh) REFRESH_CACHE=true ;;
            -c|--cli)     CLI_MODE=true ;;
            -s|--sudo)    USE_SUDO=true ;;
            -u|--update)  UPDATE_CACHE=true ;;
            --pm)
                [[ -n "${2:-}" ]] || { echo "Error: --pm requires a package manager." >&2; exit 1; }
                REQUESTED_PM="$2"; shift ;;
            --show)    
                case "$2" in
                    i|installed)   SHOW_MODE="INSTALLED" ;;
                    u|upgradeable) SHOW_MODE="UPGRADEABLE" ;;
                    a|all)         SHOW_MODE="ALL" ;;
                    *) echo "${RED}Invalid show mode: $2${RESET}"; exit 1 ;;
                esac
                shift ;;
            -i|--install) mode="i" ;;
            -r|--remove)  mode="r" ;;
            --upgrade)    mode="u" ;;
            -v|--version) echo "pmget v${VERSION}"; exit 0 ;;
            -h|--help)    show_help; exit 0 ;;
            --self-install) self_install "${@:2}"; exit 0 ;;
            --self-upgrade) SELF_UPGRADE=true ;;
            --info)
                [[ -n "${2:-}" ]] || { echo "Error: --info requires a package." >&2; exit 1; }
                INFO_PKG="$2"; shift ;;
            -*) echo "Error: Unknown option: $1" >&2; exit 1 ;;
            *)
                case "$mode" in
                    i) INSTALL_PKGS+=("$1") ;;
                    r) REMOVE_PKGS+=("$1") ;;
                    u) UPGRADE_PKGS+=("$1") ;;
                    *) echo "Error: Unexpected argument: $1" >&2; exit 1 ;;
                esac ;;
        esac
        shift
    done
}

# Section: CLI Mode Execution

run_cli() {
    echo "${BOLD}${BLUE}pmget${RESET} (${DETECTED_PM})$([[ "$USE_SUDO" == true ]] && echo " [sudo]")"
    local rc=0
    [[ ${#REMOVE_PKGS[@]} -gt 0 ]] && { echo "${RED}Removing:${RESET} ${REMOVE_PKGS[*]}"; run_pm remove "${REMOVE_PKGS[@]}" || rc=1; echo; }
    [[ ${#INSTALL_PKGS[@]} -gt 0 ]] && { echo "${GREEN}Installing:${RESET} ${INSTALL_PKGS[*]}"; run_pm install "${INSTALL_PKGS[@]}" || rc=1; }
    [[ ${#UPGRADE_PKGS[@]} -gt 0 ]] && { echo "${BLUE}Upgrading:${RESET} ${UPGRADE_PKGS[*]}"; run_pm upgrade "${UPGRADE_PKGS[@]}" || rc=1; }
    [[ ${#INSTALL_PKGS[@]} -eq 0 && ${#REMOVE_PKGS[@]} -eq 0 && ${#UPGRADE_PKGS[@]} -eq 0 ]] && echo "${YELLOW}No packages selected${RESET}"
    exit $rc
}

# Section: TUI Logic Initialization

require_fzf() {
    require_dependency fzf
}

run_tui() {
    require_fzf || return 1
    echo -n "${WHITE}Loading packages...${RESET} "
    
    TMP_DIR=$(mktemp -d)
    PKG_FILE="$TMP_DIR/packages"
    STATE_FILE="$TMP_DIR/state"
    INST_FILE="$TMP_DIR/installed"
    UPGR_FILE="$TMP_DIR/upgradeable"
    VER_FILE="$TMP_DIR/remote_ver"
    HEADER_FILE="$TMP_DIR/header"
    LIST_FILE="$TMP_DIR/list"
    
    (
        cached_query version 21600 fetch_remote_version > "$VER_FILE"
    ) >/dev/null 2>&1 &
    HELPER_SCRIPT="$TMP_DIR/helper.sh"
    
    trap "rm -rf '$TMP_DIR'; [[ -n \"${st_orig:-}\" ]] && stty \"\$st_orig\" 2>/dev/null; show_cursor" EXIT INT
    
    if supports_sudo && [[ $EUID -eq 0 || "$USE_SUDO" == true ]]; then
        USE_SUDO=true
        echo "__SUDO__=true" >> "$STATE_FILE"
    fi
    
    touch "$STATE_FILE" "$INST_FILE" "$UPGR_FILE"
    
    if ! load_package_data; then
        echo " ${RED}Failed to query $DETECTED_PM.${RESET}" >&2
        return 1
    fi

    # Include installed packages absent from the remote catalog, so they can
    # still be removed, and fill in Homebrew versions where available.
    awk -F'\t' 'BEGIN {OFS="\t"}
        FILENAME == ARGV[1] {installed[$1]=$2; next}
        {seen[$1]=1; if ($2 ~ /^ *$/ && $1 in installed) $2=installed[$1]; print}
        END {for (p in installed) if (!(p in seen)) print p, installed[p], p}
    ' "$INST_FILE" "$PKG_FILE" > "$PKG_FILE.tmp" && mv "$PKG_FILE.tmp" "$PKG_FILE"
    
    if [[ ! -s "$PKG_FILE" ]]; then
        echo " ${RED}Failed!${RESET}"
        exit 1
    fi
    echo " ${GREEN}OK${RESET} ($(wc -l < "$PKG_FILE" | tr -d ' ') items)"

    # Section: TUI Helper Script Generation

    printf '#!/usr/bin/env bash\nDETECTED_PM=%q\nVERSION=%q\nPM_PATH=%q\nOS_LABEL=%q\nPREVIEW_DIR=%q\nHEADER_FILE=%q\n' \
        "$DETECTED_PM" "$VERSION" "$PM_PATH" "$(os_label)" "$TMP_DIR/previews" "$HEADER_FILE" > "$HELPER_SCRIPT"
    mkdir -p "$TMP_DIR/previews"
    declare -f show_package_info supports_sudo >> "$HELPER_SCRIPT"

    cat >> "$HELPER_SCRIPT" <<'EOF'

_get_state() {
    awk -F= -v pkg="$2" '$1 == pkg {print $2}' "$1"
}

_set_state() {
    local sf="$1"
    local pkg="$2"
    local val="$3"
    awk -F= -v pkg="$pkg" -v val="$val" '
        $1 != pkg {print $0}
        END {print pkg "=" val}
    ' "$sf" > "$sf.tmp" && mv "$sf.tmp" "$sf"
}

_toggle_sudo() {
    supports_sudo || return 0
    local sf="$1"
    if grep -q "__SUDO__=true" "$sf"; then
        grep -v "__SUDO__=" "$sf" > "$sf.tmp"
        mv "$sf.tmp" "$sf"
    else
        echo "__SUDO__=true" >> "$sf"
    fi
}

_internal_state_mod() {
    local sf="$1" pkg="$2" dir="$3" inst_f="$4" upgr_f="$5"
    local s=$(_get_state "$sf" "$pkg")
    [[ -z "$s" ]] && s=0
    
    # Determine package status
    local is_inst=0 is_upgr=0
    awk -F'\t' -v p="$pkg" 'BEGIN{c=1} $1==p{c=0;exit} END{exit c}' "$inst_f" && is_inst=1
    awk -F'\t' -v p="$pkg" 'BEGIN{c=1} $1==p{c=0;exit} END{exit c}' "$upgr_f" && is_upgr=1
    
    local n=0
    if [[ "$dir" == "next" || "$dir" == "toggle_or_select" ]]; then
        if [[ $is_inst -eq 0 ]]; then
            [[ "$s" == "1" ]] && n=0 || n=1
        elif [[ $is_upgr -eq 1 ]]; then
            if [[ "$s" == "3" ]]; then n=2; elif [[ "$s" == "2" ]]; then n=0; else n=3; fi
        else
            [[ "$s" == "2" ]] && n=0 || n=2
        fi
    elif [[ "$dir" == "prev" ]]; then
        if [[ $is_inst -eq 0 ]]; then
            [[ "$s" == "1" ]] && n=0 || n=1
        elif [[ $is_upgr -eq 1 ]]; then
            if [[ "$s" == "2" ]]; then n=3; elif [[ "$s" == "3" ]]; then n=0; else n=2; fi
        else
            [[ "$s" == "2" ]] && n=0 || n=2
        fi
    fi
    _set_state "$sf" "$pkg" "$n"
}
 
_info() {
    local pm_name="$1"
    local pm_path="$2"
    local pkg="$3"
    local key="$pkg"
    key=${key//%/%25}; key=${key//\//%2F}; key=${key//:/%3A}
    local cached="$PREVIEW_DIR/$key" temporary="$PREVIEW_DIR/$key.$BASHPID"
    if [[ -f "$cached" ]]; then printf '%s\n' "$(<"$cached")"; return; fi
    # Avoid starting network queries for every package passed while scrolling.
    sleep 0.15
    if {
        echo -e "\033[1m\033[34mPackage Information:\033[0m\n"
        show_package_info "$pm_name" "$pm_path" "$pkg"
    } > "$temporary" 2>&1; then
        mv -f "$temporary" "$cached"
        printf '%s\n' "$(<"$cached")"
    else
        printf '%s\n' "$(<"$temporary")"
        rm -f "$temporary"
        return 1
    fi
}

_internal_gen_list() {
    local pkg_file="$1"
    local state_file="$2"
    local inst_file="$3"
    local upgr_file="$4"
    local filter_mode="${5:-ALL}"
    local search_tag="${6:-}"
    local update_pkg="${7:-}"
    local action="${8:-}"
    local emit_header="${9:-1}"
    local sudo_available=0
    supports_sudo && sudo_available=1
    local row_cache="$pkg_file.rows" row_temporary="$pkg_file.rows.$BASHPID"
    local input_file="$pkg_file" cached_rows=0
    if [[ -s "$row_cache" ]]; then input_file="$row_cache"; cached_rows=1; fi
    
    if ! awk -v state_file="$state_file" -v inst_file="$inst_file" -v upgr_file="$upgr_file" \
        -v filter_mode="$filter_mode" -v search_tag="$search_tag" \
        -v update_pkg="$update_pkg" -v action="$action" -v sudo_available="$sudo_available" \
        -v os_label="$OS_LABEL" -v pm_name="$DETECTED_PM" \
        -v cached_rows="$cached_rows" -v row_cache="$row_temporary" \
        -v header_file="$HEADER_FILE" -v emit_header="$emit_header" '
    function header(text) {
        print text > header_file
        if (emit_header) print "_\t" text
    }
    BEGIN {
        sudo_on = 0
        if (state_file != "") {
            while ((getline line < state_file) > 0) {
                split(line, parts, "=")
                if (parts[1] == "__SUDO__" && parts[2] == "true") sudo_on = 1
                if (parts[1] !~ /^__/) state[parts[1]] = parts[2]
            }
            close(state_file)
        }
        if (inst_file != "") {
            while ((getline line < inst_file) > 0) {
                split(line, parts, "\t+")
                val = parts[2]
                installed[parts[1]] = val
            }
            close(inst_file)
        }
        if (upgr_file != "") {
            while ((getline line < upgr_file) > 0) {
                split(line, parts, "\t+")
                val = parts[2]
                upgradeable[parts[1]] = val
            }
            close(upgr_file)
        }

        changed = 0
        if (action == "toggle-sudo") {
            sudo_on = !sudo_on
            changed = 1
        }
        if (update_pkg != "" && action != "" && action != "toggle-sudo") {
             pkg = update_pkg
             s = state[pkg]; if (s == "") s = 0
             is_inst = (pkg in installed)
             is_upgr = (pkg in upgradeable)
             
             n = 0
             if (action == "next" || action == "toggle_or_select") {
                 if (is_inst == 0) {
                     n = (s == 1 ? 0 : 1)
                 } else if (is_upgr == 1) {
                     if (s == 3) n = 2; else if (s == 2) n = 0; else n = 3;
                 } else {
                     n = (s == 2 ? 0 : 2)
                 }
             } else if (action == "prev") {
                 if (is_inst == 0) {
                     n = (s == 1 ? 0 : 1)
                 } else if (is_upgr == 1) {
                     if (s == 2) n = 3; else if (s == 3) n = 0; else n = 2;
                 } else {
                     n = (s == 2 ? 0 : 2)
                 }
             }
             if (s != n) {
                 state[pkg] = n
                 changed = 1
             }
        }

        if (changed) {
            printf "__SUDO__=%s\n", (sudo_on ? "true" : "false") > state_file
            for (p in state) {
                if (state[p] != "" && state[p] != "0")
                   printf "%s=%s\n", p, state[p] > state_file
            }
            close(state_file)
        }
        
        if (action == "upgrade-all") {
             for (p in upgradeable) {
                 s = state[p]
                 if (s != "3") {
                     state[p] = "3"
                     changed = 1
                 }
             }
             if (changed) {
                printf "__SUDO__=%s\n", (sudo_on ? "true" : "false") > state_file
                for (p in state) {
                    if (state[p] != "" && state[p] != "0")
                       printf "%s=%s\n", p, state[p] > state_file
                }
                close(state_file)
             }
        }

        GREEN="\033[32m"; RED="\033[31m"; YELLOW="\033[33m"; BLUE="\033[34m"; MAGENTA="\033[35m"
        CYAN="\033[36m"; GREY="\033[90m"; WHITE="\033[97m"; BOLD="\033[1m"; RESET="\033[0m"
        
        n_inst=0; n_rem=0; n_upgr=0
        for (p in state) {
            if (state[p] == "1") n_inst++
            else if (state[p] == "2") n_rem++
            else if (state[p] == "3") n_upgr++
        }
        
        n_avail_upgr=0
        for (p in upgradeable) {
            if (state[p] != "3") n_avail_upgr++
        }
        
        header(sprintf("%s%sSPEC %s%s | %s%s", BOLD, CYAN, WHITE, os_label, pm_name, RESET))
        header(sprintf("%s%s%s %s%s%s", BOLD, YELLOW, (sudo_available ? "SUDO" : "PRIV"), (sudo_available ? (sudo_on ? GREEN "● ON" : RED "○ OFF") : GREY "Managed by package manager"), RESET, BOLD))
        header(sprintf("%s%sCURR %s[+] %s%d  %s[-] %s%d  %s[↑] %s%d  %s[^] %s%d%s", BOLD, BLUE, GREEN, WHITE, n_inst, RED, WHITE, n_rem, CYAN, WHITE, n_upgr, YELLOW, WHITE, n_avail_upgr, RESET))
        header(sprintf("%s%sKEYS %s%s␣ Select Package  ⏎ Apply Changes%s", BOLD, CYAN, WHITE, (sudo_available ? "↹ Toggle Sudo  " : ""), RESET))
        header(sprintf("%s%sCTRL %sV Toggle Info  T First   B Last  U Upgrade All%s", BOLD, MAGENTA, WHITE, RESET))
        header(sprintf("%s%sREPO %sgithub.com/gabrielmsilva00/pmget%s", BOLD, WHITE, CYAN, RESET))
    }
    {
        split($0, arr, "\t+")
        pkg = arr[1] 
        avail_ver = arr[2]
        display = arr[3]
        if (display == "") display = pkg
        if (avail_ver == " ") avail_ver = ""
        
        s = state[pkg]; is_inst = (pkg in installed); is_upgr = (pkg in upgradeable)
        suffix = (search_tag != "" ? "\t" search_tag : "")
        if (cached_rows) {
            if (filter_mode == "INSTALLED" && !is_inst) next
            if (filter_mode == "UPGRADEABLE" && !is_upgr) next
            if (s == "1" || s == "2" || s == "3") {
                col = BOLD (s == "1" ? GREEN : (s == "2" ? RED : CYAN))
                sym = (s == "1" ? "[+]" : (s == "2" ? "[-]" : "[↑]"))
                name = substr(arr[2], index(arr[2], "] ") + 2)
                printf "%s\t%s%s %s\t%s\t%s%s\n", pkg, col, sym, name, arr[3], arr[4], suffix
            } else print $0 suffix
            next
        }
        
        # Truncate Name
        pkg_disp = pkg
        if (length(pkg) > 30) pkg_disp = substr(pkg, 1, 30)

        # Truncate Version Components
        v_inst = installed[pkg]
        v_upgr = upgradeable[pkg]
        v_avail = avail_ver
        
        # Helper truncate function logic inline
        if (length(v_inst) > 20) v_inst = substr(v_inst, 1, 20)
        if (length(v_upgr) > 20) v_upgr = substr(v_upgr, 1, 20)
        if (length(v_avail) > 20) v_avail = substr(v_avail, 1, 20)

        ver_info = ""
        if (is_upgr) {
            ver_info = YELLOW v_inst RESET " → " GREEN v_upgr RESET
        } else if (is_inst) {
            ver_info = WHITE v_inst RESET
        } else {
            ver_info = GREY v_avail RESET
        }

        sym = "[ ]"; col = RESET
        if (is_upgr) { sym = "[^]"; col = BOLD YELLOW }
        else if (is_inst) { sym = "[✓]"; col = BOLD BLUE }
        base_sym = sym; base_col = col
        if (s == "1") { sym = "[+]"; col = BOLD GREEN }
        else if (s == "2") { sym = "[-]"; col = BOLD RED }
        else if (s == "3") { sym = "[↑]"; col = BOLD CYAN }
        else if (is_upgr) { sym = "[^]"; col = BOLD YELLOW }
        else if (is_inst) { sym = "[✓]"; col = BOLD BLUE }
        
        if (ver_info == "" || ver_info == (GREY RESET)) ver_info = " "

        # Name Padding (Field 2)
        # Visual length = 3 (sym) + 1 (space) + length(pkg_disp)
        vis_len_name = 4 + length(pkg_disp)
        pad_name = 36 - vis_len_name
        if (pad_name < 1) pad_name = 1
        padding_name = sprintf("%*s", pad_name, "")
        
        # Version Padding (Field 3)
        # We need to pad field 3 so field 4 (description) aligns
        # Visual length of version is tricky due to colors.
        # But we know the CONTENT length.
        # If is_upgr: len = len(v_inst) + 3 (" → ") + len(v_upgr)
        # Else: len = len(v_current)
        
        content_len_ver = 0
        if (is_upgr) content_len_ver = length(v_inst) + 3 + length(v_upgr)
        else if (is_inst) content_len_ver = length(v_inst)
        else content_len_ver = length(v_avail)
        
        pad_ver = 25 - content_len_ver
        if (pad_ver < 1) pad_ver = 1
        padding_ver = sprintf("%*s", pad_ver, "")

        # Cache static formatting once; reloads update only selection markers.
        printf "%s\t%s%s %s%s%s\t%s%s\t%s%s\n", pkg, base_col, base_sym, pkg_disp, RESET, padding_name, ver_info, padding_ver, display, RESET > row_cache
        if (filter_mode == "INSTALLED" && !is_inst) next
        if (filter_mode == "UPGRADEABLE" && !is_upgr) next
        
        # Field 1: pkg (ID)
        # Field 2: Name Col
        # Field 3: Version Col + Padding
        # Field 4: Description
        
        printf "%s\t%s%s %s%s%s\t%s%s\t%s%s%s\n", pkg, col, sym, pkg_disp, RESET, padding_name, ver_info, padding_ver, display, RESET, suffix
    }
    ' "$input_file"; then
        rm -f "$row_temporary"
        return 1
    fi
    if [[ "$cached_rows" -eq 0 ]]; then mv -f "$row_temporary" "$row_cache"; fi
    return 0
}

_internal_smart_reload() {
    local query="$1"
    local force="$2"
    local mode_file="$3"
    local pkg_file="$4"
    local state_file="$5"
    local inst_file="$6"
    local upgr_file="$7"
    
    local current_mode="ALL"
    [[ -f "$mode_file" ]] && current_mode=$(<"$mode_file")
    
    local target_mode="ALL"
    local tag=""
    
    if [[ "$query" == ":i"* ]]; then
        target_mode="INSTALLED"
        tag=":i"
    elif [[ "$query" == ":u"* ]]; then
        target_mode="UPGRADEABLE"
        tag=":u"
    elif [[ "$query" == ":"* ]]; then
        target_mode="ALL"
        tag="$query"
    fi
    
    if [[ "$force" != "force" && "$target_mode" == "$current_mode" ]]; then
        exit 1
    fi
    
    echo "$target_mode" > "$mode_file"
    _internal_gen_list "$pkg_file" "$state_file" "$inst_file" "$upgr_file" "$target_mode" "$tag"
}

case "$1" in
    gen-list)     _internal_gen_list "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" ;;
    list)         _internal_gen_list "$2" "$3" "$4" "$5" "$6" "$7" "$8" "$9" 0 ;;
    update-state) _internal_state_mod "$2" "$3" "$4" "$5" "$6" ;;
    toggle-sudo)  _toggle_sudo "$2" ;;
    get-prompt)
        ver_file="$2"
        r_ver=""
        [[ -f "$ver_file" ]] && r_ver=$(<"$ver_file")
        
        col="\033[92m"
        
        if [[ -n "$r_ver" && "$r_ver" != "$VERSION" ]]; then
            IFS=. read -r l_maj l_min l_pat <<< "$VERSION"
            IFS=. read -r r_maj r_min r_pat <<< "$r_ver"
           
            if (( r_maj > l_maj )); then
                col="\033[90m" # Grey (Major)
            elif (( r_min > l_min )); then
                col="\033[31m" # Red (Minor)
            elif (( r_pat > l_pat )); then
                col="\033[33m" # Yellow (Patch)
            fi
        fi
        
        echo -e "\033[34mpmget ${col}v${VERSION}\033[34m> \033[0m"
        ;;
    info)         _info "$DETECTED_PM" "$PM_PATH" "$2" ;;
esac
EOF
    
    local helper_cmd
    # fzf already runs callbacks in Bash; source the helper in that process
    # rather than launching a second Bash for every key press and preview.
    printf -v helper_cmd 'source %q' "$HELPER_SCRIPT"
    
    local cmd_reload
    printf -v cmd_reload '%s list %q %q %q %q %q' \
        "$helper_cmd" "$PKG_FILE" "$STATE_FILE" "$INST_FILE" "$UPGR_FILE" "$SHOW_MODE"
    # fzf quotes field placeholders for the configured shell.
    local cmd_next="$cmd_reload '' {1} next"
    local cmd_prev="$cmd_reload '' {1} prev"
    local cmd_toggle="$cmd_reload '' {1} toggle_or_select"
    local cmd_sudo="$cmd_reload '' '' toggle-sudo"
    supports_sudo || cmd_sudo="$cmd_reload"
    local cmd_upgr_all="$cmd_reload '' '' upgrade-all"
    
    local cmd_preview="$helper_cmd info {1}"
    local cmd_header
    printf -v cmd_header 'printf "%%s\\n" "$(<%q)"' "$HEADER_FILE"

    if [[ -t 0 ]]; then
        st_orig=$(stty -g)
        stty -icanon -echo
    fi
    hide_cursor
    
    local fzf_exit_code=0
    
    local fzf_mouse_opt=""
    if [[ "$(uname -o 2>/dev/null)" == "Android" ]]; then
        fzf_mouse_opt="--no-mouse"
    fi
    local -a fzf_opts=(
        --ansi
        --sync
        --no-multi
        --delimiter=$'\t'
        --with-nth=2,3,4
        --header-lines=0
        --tiebreak=begin,index
        --preview="$cmd_preview"
        --preview-window="top:30%"
        --layout=reverse
        --info=inline
        --no-bold
        --no-hscroll
        --bind "right:reload-sync($cmd_next)"
        --bind "left:reload-sync($cmd_prev)"
        --bind "space:reload-sync($cmd_toggle)"
        --bind "tab:reload-sync($cmd_sudo)"
        --bind "ctrl-v:toggle-preview,alt-v:toggle-preview"
        --bind "ctrl-t:first,alt-t:first"
        --bind "ctrl-b:last,alt-b:last"
        --bind "enter:accept"
        --bind "load:transform-header($cmd_header)"
        --bind "ctrl-u:reload-sync($cmd_upgr_all),alt-u:reload-sync($cmd_upgr_all)"
    )

    # Keep callback command strings unchanged when crossing into native fzf:
    # MSYS path rewriting would turn /usr/bin/bash into an unquoted path under
    # Program Files. Every callback path is already escaped for Bash above.
    # Select Bash for reloads/previews, including native Windows fzf. SHELL
    # supports executable paths containing spaces (unlike --with-shell).
    local fzf_shell="$BASH"
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            fzf_shell=$(cygpath -w "$BASH")
            ;;
    esac

    if [[ -n "$fzf_mouse_opt" ]]; then
        fzf_opts+=("$fzf_mouse_opt")
    fi

    # Section: TUI Main Loop & FZF Integration

    while true; do
        local prompt_str="v${VERSION} ${BLUE}pmget> ${RESET}"
        if [[ -f "$VER_FILE" ]]; then
            local r_ver
            r_ver=$(<"$VER_FILE")
            if [[ -n "$r_ver" && "$r_ver" != "$VERSION" ]]; then
                 local col="\033[92m"
                 IFS=. read -r l_maj l_min l_pat <<< "$VERSION"
                 IFS=. read -r r_maj r_min r_pat <<< "$r_ver"
                 if (( r_maj > l_maj )); then col="\033[90m";
                 elif (( r_min > l_min )); then col="\033[31m";
                 elif (( r_pat > l_pat )); then col="\033[33m";
                 fi
                 prompt_str="${BLUE}pmget ${col}v${VERSION}${BLUE}> ${RESET}"
            fi
        fi

        # Read a completed file directly, avoiding the slow MSYS-to-native input
        # pipe. Update counters separately from reload-sync header-line events.
        source "$HELPER_SCRIPT" list "$PKG_FILE" "$STATE_FILE" "$INST_FILE" "$UPGR_FILE" "$SHOW_MODE" > "$LIST_FILE" || return 1
        MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' SHELL="$fzf_shell" \
        fzf "${fzf_opts[@]}" --header="$(<"$HEADER_FILE")" --prompt "$prompt_str" < "$LIST_FILE" > /dev/null
        
        fzf_exit_code=$?
        
        [[ -n "${st_orig:-}" ]] && stty "$st_orig" 2>/dev/null || true
        show_cursor
        
        if [[ $fzf_exit_code -ne 0 ]]; then
            local n_inst n_rem n_upgr
            n_inst=$(grep -c '=1$' "$STATE_FILE" 2>/dev/null) || true; n_inst=${n_inst:-0}
            n_rem=$(grep -c '=2$' "$STATE_FILE" 2>/dev/null)  || true; n_rem=${n_rem:-0}
            n_upgr=$(grep -c '=3$' "$STATE_FILE" 2>/dev/null) || true; n_upgr=${n_upgr:-0}

            if [[ "$n_inst" -eq 0 && "$n_rem" -eq 0 && "$n_upgr" -eq 0 ]]; then
                echo
                return 0
            fi

            echo -e "  ${YELLOW}Exit without changes?${RESET}"
            echo -e "  ${BOLD}${WHITE}Selected:${RESET}"
            echo -e "    ${GREEN}$n_inst${RESET} Install"
            echo -e "    ${RED}$n_rem${RESET} Remove"
            echo -e "    ${BLUE}$n_upgr${RESET} Upgrade"
            echo
            echo -n "  Press ${BOLD}Enter/Space${RESET} to return, ${BOLD}any other key${RESET} to exit: "
            
            local key
            read -rsn1 key < /dev/tty
            
            if [[ -z "$key" || "$key" == " " ]]; then
                echo
                # Restore non-canonical mode for fzf
                if [[ -t 0 ]]; then
                    stty -icanon -echo
                fi
                hide_cursor
                continue
            else
                echo
                echo "${CYAN}Exited without changes.${RESET}"
                return 0
            fi
        fi
        
        if [[ -f "$STATE_FILE" ]] && grep -q "__SUDO__=true" "$STATE_FILE"; then
            USE_SUDO=true
        else
            USE_SUDO=false
        fi

        local inst=$(grep '=1$' "$STATE_FILE" 2>/dev/null | cut -d= -f1 | tr '\n' ' ')
        local rem=$(grep '=2$' "$STATE_FILE" 2>/dev/null | cut -d= -f1 | tr '\n' ' ')
        local upgr=$(grep '=3$' "$STATE_FILE" 2>/dev/null | cut -d= -f1 | tr '\n' ' ')
         
        if [[ -z "$inst" && -z "$rem" && -z "$upgr" ]]; then
             echo -e "  ${YELLOW}No packages selected${RESET}"
             return 0
        fi

        echo -e "  ${BOLD}${WHITE}Pending Changes:${RESET}"
        [[ -n "$inst" ]] && echo -e "  ${GREEN}[+]${RESET} Install:  $inst"
        [[ -n "$rem" ]] && echo -e "  ${RED}[-]${RESET} Remove:   $rem"
        [[ -n "$upgr" ]] && echo -e "  ${BLUE}[↑]${RESET} Upgrade:  $upgr"
        [[ "$USE_SUDO" == true ]] && echo -e "  ${YELLOW}●${RESET} Sudo:     enabled"
        echo
        echo -n "  Press ${BOLD}Enter${RESET} to proceed, ${BOLD}Esc${RESET} to go back: "
        
        local key
        read -rsn1 key < /dev/tty
        
        if [[ -z "$key" ]]; then
            echo
            break
        else
            echo
            # Restore non-canonical mode for fzf
            if [[ -t 0 ]]; then
                stty -icanon -echo
            fi
            hide_cursor
            continue
        fi
    done
    
    [[ -n "${st_orig:-}" ]] && stty "$st_orig" 2>/dev/null || true
    show_cursor
    
    echo
    echo "${WHITE}> Executing...${RESET}"
    INSTALL_PKGS=(); REMOVE_PKGS=(); UPGRADE_PKGS=()
    [[ -n "$inst" ]] && read -r -a INSTALL_PKGS <<< "$inst"
    [[ -n "$rem" ]] && read -r -a REMOVE_PKGS <<< "$rem"
    [[ -n "$upgr" ]] && read -r -a UPGRADE_PKGS <<< "$upgr"
    run_cli
}

# Section: Main Execution Entry

main() {
    forward_to_wsl "$@" || return $?
    parse_args "$@"
    if [[ "$SELF_UPGRADE" == true ]]; then
        perform_self_upgrade
        return $?
    fi
    detect_pm || return 1
    if ! supports_sudo; then
        if [[ "$USE_SUDO" == true ]]; then
            echo "${YELLOW}$DETECTED_PM manages its own privileges; --sudo is ignored. For Chocolatey, use an elevated Git Bash when required.${RESET}" >&2
        fi
        USE_SUDO=false
    fi
    [[ -n "$INFO_PKG" ]] && { show_info "$INFO_PKG"; return $?; }
    if [[ "$UPDATE_CACHE" == true ]]; then
        update_cache || return $?
        REFRESH_CACHE=true
        local directory
        directory=$(cache_directory)
        rm -f "$directory/catalog.v1.time" "$directory"/upgrades-*.v1.time
    fi
    [[ "$CLI_MODE" == true ]] && run_cli || run_tui
}

# All functions must be defined before dispatching a piped self-installer.
if [[ -z "${PMGET_INSTALLING:-}" && ! -t 0 && "${BASH_SOURCE[0]}" == "$0" && ! -f "${BASH_SOURCE[0]}" ]]; then
    skip_install=false
    for arg in "$@"; do
        case "$arg" in
            -v|--version|-h|--help|--info|--wsl) skip_install=true; break ;;
        esac
    done
    [[ "$skip_install" == false ]] && self_install "$@"
fi

if [[ -z "${BASH_SOURCE[0]:-}" || "${BASH_SOURCE[0]}" == "$0" ]]; then
    main "$@"
fi
