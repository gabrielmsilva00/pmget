#!/usr/bin/env bash
# pmget - Package Manager Getter (https://github.com/gabrielmsilva00/pmget)
if (( BASH_VERSINFO[0] < 4 )); then
    echo "Error: pmget requires Bash 4 or newer (use Git Bash on Windows)." >&2
    exit 1
fi
VERSION="1.0.0"
REPO="gabrielmsilva00/pmget"
LICENSE="Apache-2.0"
MAINTAINERS=("Gabriel Silva (@gabrielmsilva00)")
SUPPORTED_PMS=(nala apt dnf pacman zypper apk brew winget choco)
REQUESTED_PM="${PMGET_PM:-}"

pm_candidates() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) printf '%s\n' winget choco brew nala apt dnf pacman zypper apk ;;
        Darwin*) printf '%s\n' brew nala apt dnf pacman zypper apk winget choco ;;
        *) printf '%s\n' "${SUPPORTED_PMS[@]}" ;;
    esac
}

supports_sudo() {
    case "$DETECTED_PM" in brew|winget|choco) return 1 ;; esac
}

os_label() {
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) echo Windows ;;
        Darwin*) echo macOS ;;
        Linux)
            if [[ -n "${WSL_DISTRO_NAME:-}${WSL_INTEROP:-}" || "$(uname -r)" == *[Mm]icrosoft* ]]; then
                echo 'Linux (WSL)'
            else
                echo Linux
            fi ;;
        *) uname -s ;;
    esac
}

# Dispatch before parsing actions, so --wsl also applies to --info, --help,
# and the self-installer regardless of the flag order.
forward_to_wsl() {
    local arg requested=false
    local -a forwarded=()
    for arg in "$@"; do
        case "$arg" in
            --wsl) requested=true ;;
            *) forwarded+=("$arg") ;;
        esac
    done
    [[ "$requested" == true ]] || return 0
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*) ;;
        *) return 0 ;;
    esac
    command -v wsl.exe &>/dev/null || {
        echo "Error: --wsl requires WSL and an installed Linux distribution." >&2
        return 1
    }
    local script_path="${BASH_SOURCE[0]}"
    [[ -f "$script_path" ]] || {
        echo "Error: --wsl requires a saved pmget script. Download pmget first, then run bash ./pmget --wsl." >&2
        return 1
    }
    script_path=$(cygpath -aw "$script_path") || return 1
    # Pass paths and user arguments as positional parameters. Disable MSYS
    # conversion because wslpath, running inside WSL, handles the Windows path.
    local status=0
    MSYS_NO_PATHCONV=1 MSYS2_ARG_CONV_EXCL='*' wsl.exe --exec bash -c '
        script_path=$(wslpath -u "$1") || exit $?
        export PMGET_PM="$2"
        shift 2
        exec bash "$script_path" "$@"
    ' pmget-wsl "$script_path" "${PMGET_PM:-}" "${forwarded[@]}" || status=$?
    exit "$status"
}


BOLD=""; RESET=""; RED=""; GREEN=""; YELLOW=""; BLUE=""; CYAN=""; WHITE=""
if [[ -t 1 && "${TERM:-}" != dumb && -z "${NO_COLOR:-}" ]]; then
    BOLD=$'\033[1m'; RESET=$'\033[0m'; RED=$'\033[31m'; GREEN=$'\033[32m'
    YELLOW=$'\033[33m'; BLUE=$'\033[34m'; CYAN=$'\033[36m'; WHITE=$'\033[37m'
fi

show_cursor() { [[ ! -t 1 ]] || printf '\033[?25h'; }
hide_cursor() { [[ ! -t 1 ]] || printf '\033[?25l'; }

# Section: Self-Installation Logic

PMGET_URL="https://raw.githubusercontent.com/${REPO}/main/pmget"

self_install() {
    local install_mode=""
    local need_sudo=false
    local install_dir=""

    while [[ $# -gt 0 ]]; do
        case "$1" in
            --root|--usr|--local)
                [[ -n "$install_mode" ]] && { echo "${RED}Error: Only one of --root, --usr, --local allowed${RESET}"; exit 1; }
                install_mode="${1#--}"
                ;;
            --pm)
                [[ -n "${2:-}" ]] || { echo "Error: --pm requires a package manager." >&2; exit 1; }
                REQUESTED_PM="$2"; shift ;;
            -h|--help)
                echo "pmget self-installer v${VERSION}"
                echo "Usage: curl -fsSL <url>/pmget | bash [-s -- OPTIONS]"
                echo "       pmget --install [--local | --usr | --root]"
                echo ""
                echo "Options:"
                echo "  --local  Install to ~/.local/bin (default)"
                echo "  --usr    Install to /usr/local/bin (requires sudo)"
                echo "  --root   Install to /root/.local/bin (requires sudo)"
                exit 0
                ;;
        esac
        shift
    done

    case "${install_mode:-local}" in
        local) install_dir="$HOME/.local/bin" ;;
        usr)   install_dir="/usr/local/bin"; need_sudo=true ;;
        root)  install_dir="/root/.local/bin"; need_sudo=true ;;
    esac

    echo "${BOLD}${BLUE}pmget installer${RESET}"
    echo "${BLUE}Target:${RESET}     $install_dir"
    echo "${BLUE}Repo:${RESET}       https://github.com/$REPO"
    echo "${BLUE}Devs:${RESET}       ${MAINTAINERS[*]}"
    echo "${BLUE}License:${RESET}    $LICENSE"
    echo "${BLUE}Disclaimer:${RESET} This application was heavily inspired by the Hydra0xetc/Search project."
    echo "            You can check their work at https://github.com/Hydra0xetc/Search"
    echo

    existing_pmget=$(command -v pmget 2>/dev/null) || true
    if [[ -n "$existing_pmget" ]]; then
        if grep -q "github.com/gabrielmsilva00/pmget" "$existing_pmget" 2>/dev/null; then
            local current_ver
            current_ver=$(grep "^VERSION=" "$existing_pmget" 2>/dev/null | head -n 1 | cut -d'"' -f2)
            current_ver="${current_ver:-?}"
            if [[ "$current_ver" == "$VERSION" ]]; then
                echo -n "pmget v${VERSION} is already installed. Reinstall? [y/N] "
                local response
                if [[ -c /dev/tty ]]; then
                    read -r -n 1 response < /dev/tty
                else
                    read -r -n 1 response 2>/dev/null || response="n"
                fi

                if [[ ! "$response" =~ ^[yY]$ ]]; then
                    echo
                    exit 0
                fi
                echo
                echo "${WHITE}→${RESET} Reinstalling v${VERSION}..."
            else
                echo "${WHITE}→${RESET} Updating pmget v${current_ver} to v${VERSION}"
            fi
        else
            echo "${YELLOW}⚠${RESET} Different 'pmget' found: $existing_pmget"
            echo "  Will install to: $install_dir/pmget"
        fi
        echo
    fi

    detect_pm || exit 1
    local pm_found="$DETECTED_PM" dependency
    echo "${GREEN}✓${RESET} $pm_found"
    for dependency in curl fzf; do
        require_dependency "$dependency" || exit 1
        echo "${GREEN}✓${RESET} $dependency"
    done

    echo

    local tmpfile
    tmpfile=$(mktemp)
    if ! curl -fsSL -H "Cache-Control: no-cache" "$PMGET_URL" -o "$tmpfile"; then
        echo "${RED}Download failed${RESET}"
        rm -f "$tmpfile"
        exit 1
    fi

    if [[ ! -s "$tmpfile" ]] || ! grep -q "github.com/gabrielmsilva00/pmget" "$tmpfile"; then
        echo "${RED}Download invalid or corrupted${RESET}"
        rm -f "$tmpfile"
        exit 1
    fi

    local install_success=false

    if [[ "$need_sudo" == true ]]; then
        echo "${WHITE}→${RESET} Attempting install with sudo..."
        if sudo mkdir -p "$install_dir" 2>/dev/null && \
           sudo cp "$tmpfile" "$install_dir/pmget" 2>/dev/null && \
           sudo chmod +x "$install_dir/pmget" 2>/dev/null; then
            install_success=true
        else
            echo "${YELLOW}⚠${RESET} Sudo failed, trying without sudo..."
            need_sudo=false
        fi
    fi

    if [[ "$install_success" == false ]]; then
        if mkdir -p "$install_dir" 2>/dev/null && \
           mv "$tmpfile" "$install_dir/pmget" 2>/dev/null && \
           chmod +x "$install_dir/pmget" 2>/dev/null; then
            install_success=true
        fi
    fi

    rm -f "$tmpfile" 2>/dev/null

    if [[ "$install_success" == false ]]; then
        echo "${RED}✗ Installation failed${RESET}"
        echo "  Could not write to: $install_dir"
        echo "  Try: pmget --self-install --local"
        exit 1
    fi

    echo "${GREEN}✓${RESET} pmget v${VERSION} installed to $install_dir/pmget"

    echo
    echo "${WHITE}→${RESET} Performing initial system update..."
    export PMGET_INSTALLING=true
    if [[ "$need_sudo" == true ]]; then
        PMGET_PM="$pm_found" "$install_dir/pmget" -s -u
    else
        PMGET_PM="$pm_found" "$install_dir/pmget" -u
    fi

    if [[ "$need_sudo" == false && ":$PATH:" != *":$install_dir:"* ]]; then
        local shell_name shell_rc
        shell_name=$(basename "$SHELL")
        case "$shell_name" in
            zsh)  shell_rc="$HOME/.zshrc" ;;
            bash) shell_rc="$HOME/.bashrc" ;;
            *)    shell_rc="$HOME/.profile" ;;
        esac

        # Ensure we append to PATH safely and only if needed
        if ! grep -qF "$install_dir" "$shell_rc" 2>/dev/null; then
            echo "" >> "$shell_rc"
            echo "# pmget" >> "$shell_rc"
            echo "case \":\$PATH:\" in" >> "$shell_rc"
            echo "    *\"$install_dir\"*) ;;" >> "$shell_rc"
            echo "    *) export PATH=\"\$PATH:$install_dir\" ;;" >> "$shell_rc"
            echo "esac" >> "$shell_rc"
            
            echo "${GREEN}✓${RESET} Added to PATH in $shell_rc"
            echo "${YELLOW}!${RESET} Run: source $shell_rc"
        fi
    fi

    echo -e "\n${GREEN}Done!${RESET} Run: pmget"
    exit 0
}

# Section: Self-Upgrade Logic

perform_self_upgrade() {
    require_dependency curl || exit 1
    echo "Checking for updates..."
    local tmpfile
    tmpfile=$(mktemp)
    if ! curl -fsSL -H "Cache-Control: no-cache" "$PMGET_URL" -o "$tmpfile"; then
        echo "${RED}Download failed${RESET}"
        rm -f "$tmpfile"
        exit 1
    fi

    if [[ ! -s "$tmpfile" ]] || ! grep -q "github.com/gabrielmsilva00/pmget" "$tmpfile"; then
        echo "${RED}Download invalid or corrupted${RESET}"
        rm -f "$tmpfile"
        exit 1
    fi

    local new_ver
    new_ver=$(grep "^VERSION=" "$tmpfile" | head -n 1 | cut -d'"' -f2)
    
    if [[ "$new_ver" == "$VERSION" ]]; then
         echo "You are already on the latest version v${VERSION}."
         rm -f "$tmpfile"
         exit 0
    fi
    
    echo "New version available: $new_ver (Current: $VERSION)"
    echo "Upgrading..."
    
    local install_arg="--local"
    local current_loc
    current_loc=$(command -v pmget 2>/dev/null)
    
    if [[ "$current_loc" == "/usr/local/bin/pmget" ]]; then
        install_arg="--usr"
    elif [[ "$current_loc" == "/root/.local/bin/pmget" ]]; then
        install_arg="--root"
    fi
    
    chmod +x "$tmpfile"
    PMGET_PM="$REQUESTED_PM" "$tmpfile" --self-install "$install_arg"
    local ret=$?
    rm -f "$tmpfile"
    exit $ret
}


# Section: Constants & Cleanup

CLI_MODE=false
USE_SUDO=false
SHOW_MODE="ALL"
declare -a INSTALL_PKGS=()
declare -a REMOVE_PKGS=()
declare -a UPGRADE_PKGS=()
DETECTED_PM=""
UPDATE_CACHE=false
REFRESH_CACHE=false
INFO_PKG=""
SELF_UPGRADE=false
PKG_FILE=""
STATE_FILE=""

cleanup() {
    [[ -f "${PKG_FILE:-}" ]] && rm -f "$PKG_FILE"
    [[ -f "${STATE_FILE:-}" ]] && rm -f "$STATE_FILE"
    return 0
}
trap cleanup EXIT INT

# Section: Package Manager Detection

detect_pm() {
    [[ -n "$DETECTED_PM" ]] && return 0
    local pm
    if [[ -n "$REQUESTED_PM" ]]; then
        case "$REQUESTED_PM" in
            nala|apt|dnf|pacman|zypper|apk|brew|winget|choco) ;;
            *) echo "Error: Unsupported package manager: $REQUESTED_PM" >&2; return 1 ;;
        esac
    fi
    for pm in $(pm_candidates); do
        [[ -n "$REQUESTED_PM" && "$pm" != "$REQUESTED_PM" ]] && continue
        if command -v "$pm" &>/dev/null; then
            DETECTED_PM="$pm"
            PM_PATH=$(command -v "$pm")
            return 0
        fi
    done
    echo "${RED}Error: Package manager not found (${REQUESTED_PM:-${SUPPORTED_PMS[*]}}).${RESET}" >&2
    return 1
}

# Section: Cache Management

update_cache() {
    detect_pm
    echo -e "${BOLD}${BLUE}Updating package manager cache...${RESET}"
    local cmd=()
    [[ "$USE_SUDO" == true && $EUID -ne 0 ]] && supports_sudo && cmd+=(sudo)
    
    case "$DETECTED_PM" in
        nala|apt)
            echo -e "${WHITE}→${RESET} Cleaning and updating ${DETECTED_PM}..."
            "${cmd[@]}" "$DETECTED_PM" clean 2>/dev/null || true
            "${cmd[@]}" "$DETECTED_PM" update
            ;;
        dnf)
            echo -e "${WHITE}→${RESET} Cleaning and updating dnf..."
            "${cmd[@]}" dnf clean all
            "${cmd[@]}" dnf makecache
            ;;
        pacman)
            echo -e "${WHITE}→${RESET} Cleaning and updating pacman..."
            "${cmd[@]}" pacman -Sc --noconfirm
            "${cmd[@]}" pacman -Sy
            ;;
        zypper)
            echo -e "${WHITE}→${RESET} Cleaning and updating zypper..."
            "${cmd[@]}" zypper clean -a
            "${cmd[@]}" zypper refresh
            ;;
        apk)
            echo -e "${WHITE}→${RESET} Cleaning and updating apk..."
            "${cmd[@]}" apk cache clean
            "${cmd[@]}" apk update
            ;;
        brew) brew update ;;
        winget) winget source update --disable-interactivity ;;
        choco)
            # Chocolatey refreshes repository metadata on each query.
            echo "Chocolatey queries refresh repository metadata automatically."
            ;;
    esac
}

# Section: Package Manager Wrapper

run_pm() {
    local action="$1"; shift; local cmd=()
    [[ $# -gt 0 ]] || return 0
    [[ "$USE_SUDO" == true && $EUID -ne 0 ]] && supports_sudo && cmd+=(sudo)
    local pkg verb rc=0
    case "$DETECTED_PM" in
        winget)
            case "$action" in install) verb=install ;; remove) verb=uninstall ;; upgrade) verb=upgrade ;; *) return 1 ;; esac
            # WinGet accepts one exact ID per operation.
            for pkg in "$@"; do
                local args=("$verb" --id "$pkg" --exact --source winget --accept-source-agreements --disable-interactivity)
                [[ "$action" != remove ]] && args+=(--accept-package-agreements)
                winget "${args[@]}" || rc=1
            done
            return "$rc"
            ;;
        choco)
            case "$action" in install) verb=install ;; remove) verb=uninstall ;; upgrade) verb=upgrade ;; *) return 1 ;; esac
            local status=0
            choco "$verb" "$@" --yes --no-progress || status=$?
            # Native Windows exit codes are reduced modulo 256 by Bash.
            # Chocolatey 1641/3010 mean success with a reboot initiated/required.
            case "$status" in 0|105|194) return 0 ;; *) return "$status" ;; esac
            ;;
        brew)
            case "$action" in install) verb=install ;; remove) verb=uninstall ;; upgrade) verb=upgrade ;; *) return 1 ;; esac
            for pkg in "$@"; do
                case "$pkg" in
                    formula:*) brew "$verb" --formula "${pkg#formula:}" || rc=1 ;;
                    cask:*) brew "$verb" --cask "${pkg#cask:}" || rc=1 ;;
                    *) brew "$verb" "$pkg" || rc=1 ;;
                esac
            done
            return "$rc"
            ;;
    esac
    case "$DETECTED_PM:$action" in
        nala:install|apt:install|nala:upgrade|apt:upgrade) cmd+=("$DETECTED_PM" install -y "$@") ;;
        nala:remove|apt:remove)     cmd+=("$DETECTED_PM" remove -y "$@") ;;
        dnf:install)    cmd+=(dnf install -y "$@") ;;
        dnf:remove)     cmd+=(dnf remove -y "$@") ;;
        dnf:upgrade)    cmd+=(dnf upgrade -y "$@") ;;
        pacman:install|pacman:upgrade) cmd+=(pacman -S --noconfirm "$@") ;;
        pacman:remove)  cmd+=(pacman -R --noconfirm "$@") ;;
        zypper:install) cmd+=(zypper install -y "$@") ;;
        zypper:remove)  cmd+=(zypper remove -y "$@") ;;
        zypper:upgrade) cmd+=(zypper update -y "$@") ;;
        apk:install)    cmd+=(apk add "$@") ;;
        apk:remove)     cmd+=(apk del "$@") ;;
        apk:upgrade)    cmd+=(apk upgrade "$@") ;;
        *) echo "Error: Unsupported operation: $DETECTED_PM $action" >&2; return 1 ;;
    esac
    "${cmd[@]}"
}

# Section: Dependencies

dependency_package() {
    case "$DETECTED_PM:$1" in
        winget:fzf) echo junegunn.fzf ;;
        winget:curl) echo cURL.cURL ;;
        brew:fzf|brew:curl) echo "formula:$1" ;;
        *:fzf|*:curl) echo "$1" ;;
        *) echo "Error: No dependency package mapping for $1." >&2; return 1 ;;
    esac
}

refresh_dependency_path() {
    local dependency="$1" directory
    local -a directories=()
    case "$(uname -s)" in
        MINGW*|MSYS*|CYGWIN*)
            [[ -z "${LOCALAPPDATA:-}" ]] || directories+=("$LOCALAPPDATA/Microsoft/WinGet/Links")
            [[ -z "${ProgramData:-}" ]] || directories+=("$ProgramData/Microsoft/WinGet/Links")
            directories+=("${USERPROFILE:-$HOME}/scoop/shims" "$HOME/.fzf/bin")
            [[ -z "${SCOOP:-}" ]] || directories+=("$SCOOP/shims")
            [[ -z "${ChocolateyInstall:-}" ]] || directories+=("$ChocolateyInstall/bin")
            for directory in "${directories[@]}"; do
                directory=$(cygpath -u "$directory") || continue
                if [[ -x "$directory/$dependency.exe" && ":$PATH:" != *":$directory:"* ]]; then
                    export PATH="$PATH:$directory"
                fi
            done
            ;;
        *)
            # Homebrew's curl formula can be keg-only, outside the main bin dir.
            if [[ "$DETECTED_PM" == brew && "$dependency" == curl ]]; then
                directory=$(brew --prefix curl 2>/dev/null) || return 0
                [[ ! -x "$directory/bin/curl" || ":$PATH:" == *":$directory/bin:"* ]] || export PATH="$PATH:$directory/bin"
            fi
            ;;
    esac
    hash -r
}

confirm_dependency_install() {
    local response=""
    # Read from the terminal, never consume piped script text or an unattended
    # job's input as consent. A piped installer may still have a terminal on fd 2.
    if [[ -t 0 ]]; then
        printf '%s [y/N] ' "$1" >&2
        read -r response || return 1
    elif [[ -t 2 ]]; then
        printf '%s [y/N] ' "$1" >&2
        read -r response 2>/dev/null < /dev/tty || return 1
    else
        echo 'No interactive terminal; dependency installation was skipped.' >&2
        return 1
    fi
    [[ "${response,,}" == y || "${response,,}" == yes ]]
}

require_dependency() {
    local dependency="$1" package
    command -v "$dependency" &>/dev/null && return 0
    detect_pm || return 1
    refresh_dependency_path "$dependency"
    command -v "$dependency" &>/dev/null && return 0
    package=$(dependency_package "$dependency") || return 1
    echo "Missing dependency: $dependency (package: $package; manager: $DETECTED_PM)." >&2
    if ! confirm_dependency_install "Install $dependency using $DETECTED_PM?"; then
        echo "Error: $dependency is required for this operation. Install package $package using $DETECTED_PM and retry." >&2
        return 1
    fi
    # Dependency installation needs privilege on Linux even if --sudo wasn't
    # requested for the user's later package operations. Keep that choice local.
    local USE_SUDO=false
    if supports_sudo && (( EUID != 0 )); then
        command -v sudo &>/dev/null || {
            echo "Error: Installing $dependency with $DETECTED_PM requires root or sudo." >&2
            return 1
        }
        USE_SUDO=true
    fi
    if ! run_pm install "$package"; then
        echo "Error: Failed to install $dependency using $DETECTED_PM." >&2
        return 1
    fi
    refresh_dependency_path "$dependency"
    if ! command -v "$dependency" &>/dev/null; then
        echo "Error: $DETECTED_PM completed, but $dependency is still unavailable. Check its installation/PATH and retry." >&2
        return 1
    fi
    echo "Installed dependency: $dependency." >&2
}

# Section: Package Query Functions

# WinGet emits localized, padded tables rather than JSON. Only consume rows
# below a separator, and never pass a truncated identifier to an operation.
parse_winget_table() {
    # WinGet writes UTF-8 even when Git Bash inherits the C locale. Count
    # characters rather than bytes so localized headers keep column offsets.
    local table_locale=C.UTF-8
    [[ "$OSTYPE" != darwin* ]] || table_locale=en_US.UTF-8
    LC_ALL="$table_locale" awk -v mode="$1" '
        function trim(s) {sub(/^ +/, "", s); sub(/ +$/, "", s); return s}
        { gsub(/\r/, ""); gsub(/\033\[[0-9;?]*[A-Za-z]/, "") }
        /^-[- ]+$/ {
            # Column offsets come from the preceding localized header. Data
            # may have only one separating space, or spaces inside app names.
            rest=header; offset=0; n=0
            while (match(rest, /[^ ]+/)) {
                start[++n]=offset+RSTART
                offset+=RSTART+RLENGTH-1
                rest=substr(rest, RSTART+RLENGTH)
            }
            table=(n >= 3); next
        }
        !table {header=$0; next}
        table {
            for (i=1; i<=n; i++) col[i]=trim(substr($0, start[i], (i<n ? start[i+1]-start[i] : length($0))))
            if (col[3] == "" || col[2] ~ /…|\.\.\./ || col[2] !~ /^[A-Za-z0-9][A-Za-z0-9._+-]*$/) next
            if (mode == "packages") print col[2] "\t" col[3] "\t" col[1]
            else if (mode == "upgradeable" && n >= 4) print col[2] "\t" col[4]
            else if (mode == "installed") print col[2] "\t" col[3]
        }'
}

parse_choco_table() {
    awk -F'|' -v mode="$1" '
        { sub(/\r$/, "") }
        $1 ~ /^[A-Za-z0-9][A-Za-z0-9._-]*$/ && NF >= 2 {
            if (mode == "packages") print $1 "\t" $2 "\t" $1
            else if (mode == "upgradeable" && NF >= 4 && tolower($4) != "true") print $1 "\t" $3
            else if (mode == "installed") print $1 "\t" $2
        }'
}

query_winget() {
    local mode="$1" output status=0
    shift
    output=$(winget "$@" --source winget --accept-source-agreements --disable-interactivity) || status=$?
    # APPINSTALLER_CLI_ERROR_NO_APPLICATIONS_FOUND (0x8A150014).
    [[ "$status" -eq 20 ]] && return 0
    if [[ "$status" -ne 0 ]]; then
        printf 'WinGet query failed (%s):\n%s\n' "$status" "$output" >&2
        return 1
    fi
    printf '%s\n' "$output" | parse_winget_table "$mode"
}

query_choco() {
    local mode="$1" output status=0
    shift
    output=$(choco "$@" --limit-output --no-color) || status=$?
    # Enhanced exit code 2 means no search results, or outdated packages found.
    if [[ "$status" -ne 0 && "$status" -ne 2 ]]; then
        printf 'Chocolatey query failed (%s):\n%s\n' "$status" "$output" >&2
        return 1
    fi
    printf '%s\n' "$output" | parse_choco_table "$mode"
}

fetch_brew_packages() (
    set -o pipefail
    local kind
    for kind in formula cask; do
        # Include the macOS cask catalog alongside formulae.
        [[ "$kind" == cask && "$(uname -s)" != Darwin ]] && continue
        brew search "--$kind" '/.*/' 2>/dev/null |
            awk -v kind="$kind" '/^[A-Za-z0-9][A-Za-z0-9@+._\/-]*$/ {print kind ":" $0 "\t \t" $0}' || return $?
    done
)

fetch_brew_local() (
    set -o pipefail
    local mode="$1" kind
    for kind in formula cask; do
        [[ "$kind" == cask && "$(uname -s)" != Darwin ]] && continue
        if [[ "$mode" == installed ]]; then
            brew list "--$kind" --versions 2>/dev/null |
                awk -v kind="$kind" 'NF >= 2 {print kind ":" $1 "\t" $NF}' || return $?
        else
            brew outdated "--$kind" --verbose 2>/dev/null |
                awk -v kind="$kind" '/ (<|!=) / && !/\[pinned at / {
                    version=$0; sub(/^.* (<|!=) /, "", version)
                    print kind ":" $1 "\t" version
                }' || return $?
        fi
    done
)

fetch_packages() {
    case "$DETECTED_PM" in
        nala|apt)      apt-cache search . --full 2>/dev/null | awk -v RS='' -v FS='\n' '{
                      n=""; v=""; d=""
                      for(i=1;i<=NF;i++) {
                          if($i~/^Package: /) n=substr($i,10)
                          else if($i~/^Version: /) v=substr($i,10)
                          else if($i~/^Description: /) d=substr($i,14)
                      }
                      if(n!="") {
                          if(v=="") v=" "
                          print n "\t" v "\t" d
                      }
                  }' | sort -u -k1,1 ;;
        dnf)      dnf repoquery --qf '%{name}\t%{version}-%{release}\t%{summary}' 2>/dev/null ;;
        pacman)   pacman -Sl 2>/dev/null | awk '{print $2 "\t" $3 "\t" $2}' ;;
        zypper)   zypper packages 2>/dev/null | awk -F'|' 'NR>4{gsub(/ /,"",$3); gsub(/ /,"",$4); print $3 "\t" $4 "\t" $3}' ;;
        apk)      apk search -v 2>/dev/null | sed -E 's/^(.*)-([0-9].*) - (.*)$/\1\t\2\t\3/' | sed -E 's/^([^ ]+)-([0-9][^ ]*)$/\1\t\2\t/' ;;
        brew)     fetch_brew_packages ;;
        winget)   query_winget packages search --query "" ;;
        choco)    query_choco packages search ;;
    esac
}

fetch_installed() {
    case "$DETECTED_PM" in
        nala|apt)      dpkg-query -W -f='${Package}\t${Version}\n' 2>/dev/null ;;
        dnf)      rpm -qa --queryformat '%{NAME}\t%{VERSION}-%{RELEASE}\n' 2>/dev/null ;;
        pacman)   pacman -Q 2>/dev/null | sed 's/ /\t/' ;;
        zypper)   rpm -qa --queryformat '%{NAME}\t%{VERSION}-%{RELEASE}\n' 2>/dev/null ;;
        apk)      apk info -v 2>/dev/null | sed -E 's/(.*)-([0-9].*)/\1\t\2/' ;;
        brew)     fetch_brew_local installed ;;
        winget)   query_winget installed list ;;
        choco)    query_choco installed list ;;
    esac
}

fetch_upgradeable() {
    case "$DETECTED_PM" in
        nala|apt)      apt list --upgradeable 2>/dev/null | awk -F/ 'NR>1 && /-/{split($0,a," "); print $1 "\t" a[2]}' ;;
        dnf)      dnf list updates -q 2>/dev/null | awk 'NR>1 {match($1, /^([^.]+)/, n); print n[1] "\t" $2}' ;;
        pacman)   pacman -Qu 2>/dev/null | awk '{print $1 "\t" $4}' ;;
        zypper)   zypper list-updates 2>/dev/null | awk -F'|' 'NR>4{gsub(/ /,"",$3); gsub(/ /,"",$5); print $3 "\t" $5}' ;;
        apk)      apk version -u 2>/dev/null | sed -nE 's/^(.*)-([0-9].*) < (.*)/\1\t\3/p' ;;
        brew)     fetch_brew_local upgradeable ;;
        winget)   query_winget upgradeable list --upgrade-available ;;
        choco)    query_choco upgradeable outdated ;;
    esac
}

# Section: Information Display

cache_directory() {
    printf '%s/%s\n' "${PMGET_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/pmget}" "$DETECTED_PM"
}

# Publish successful results atomically; an empty upgrade list is valid too.
# An unwritable cache never
# prevents package queries, and failed refreshes never replace a good entry.
cached_query() {
    local key="$1" ttl="$2"; shift 2
    local directory file stamp now saved=0 temporary allow_empty=false
    [[ "$key" == upgrades-* ]] && allow_empty=true
    directory=$(cache_directory)
    file="$directory/$key.v1"; stamp="$file.time"
    now=$(date +%s)
    [[ -f "$stamp" ]] && read -r saved < "$stamp"
    if [[ "$REFRESH_CACHE" != true && -f "$file" && "$saved" =~ ^[0-9]+$ ]] &&
       [[ -s "$file" || "$allow_empty" == true ]] &&
       (( now >= saved && now - saved < ttl )); then
        cat "$file"
        return
    fi
    if ! mkdir -p "$directory" 2>/dev/null; then "$@"; return $?; fi
    temporary=$(mktemp "$directory/$key.XXXXXXXX") || { "$@"; return $?; }
    if "$@" > "$temporary"; then
        if [[ -s "$temporary" || "$allow_empty" == true ]] && mv -f "$temporary" "$file"; then
            printf '%s\n' "$now" > "$stamp"
            cat "$file"
        else
            cat "$temporary"
            rm -f "$temporary"
        fi
    else
        local status=$?
        rm -f "$temporary"
        return "$status"
    fi
}

load_package_data() {
    local catalog_pid='' installed_pid failed=0 snapshot
    # Filtered views need only local inventories; the merge below supplies rows.
    if [[ "$SHOW_MODE" == ALL ]]; then
        cached_query catalog 3600 fetch_packages > "$PKG_FILE" & catalog_pid=$!
    else
        : > "$PKG_FILE"
    fi
    fetch_installed > "$INST_FILE" & installed_pid=$!
    if wait "$installed_pid"; then
        if [[ -s "$INST_FILE" ]]; then
            # Reuse upgrade checks briefly, but never across an installation,
            # removal, or version change made by pmget or another application.
            snapshot=$(cksum < "$INST_FILE"); snapshot=${snapshot// /-}
            cached_query "upgrades-$snapshot" 60 fetch_upgradeable > "$UPGR_FILE" || failed=1
        else
            : > "$UPGR_FILE"
        fi
    else
        failed=1
    fi
    [[ -n "$catalog_pid" ]] && { wait "$catalog_pid" || failed=1; }
    return "$failed"
}

fetch_remote_version() {
    local source
    source=$(curl -fsSL --connect-timeout 2 --max-time 3 "https://raw.githubusercontent.com/${REPO}/main/pmget") || return 1
    awk -F'"' '/^VERSION=/ {print $2; found=1; exit} END {if (!found) exit 1}' <<< "$source"
}

show_info() {
    echo -e "${BOLD}${CYAN}Package Info:${RESET}\n"
    show_package_info "$DETECTED_PM" "$PM_PATH" "$1"
}

# Also embedded in the TUI helper so previews and --info stay in sync.
show_package_info() {
    local pm_name="$1" pm_path="$2" pkg="$3"
    case "$pm_name" in
        nala|apt) apt-cache show "$pkg" 2>/dev/null | grep -Ev '^(Section:|Priority:|Installed|Essential:|SHA1:|SHA256:|SHA512:|MD5sum:|Description-md5:|Filename:|Size:|Task:)' ;;
        dnf) "$pm_path" info "$pkg" 2>/dev/null ;;
        pacman) "$pm_path" -Si "$pkg" 2>/dev/null || "$pm_path" -Qi "$pkg" 2>/dev/null ;;
        zypper) "$pm_path" info "$pkg" 2>/dev/null ;;
        apk) "$pm_path" info -a "$pkg" 2>/dev/null ;;
        winget) "$pm_path" show --id "$pkg" --exact --source winget --accept-source-agreements --disable-interactivity ;;
        choco) "$pm_path" info "$pkg" --no-color ;;
        brew)
            case "$pkg" in
                formula:*) "$pm_path" info --formula "${pkg#formula:}" ;;
                cask:*) "$pm_path" info --cask "${pkg#cask:}" ;;
                *) "$pm_path" info "$pkg" ;;
            esac ;;
    esac
}

